<?xml version="1.0" encoding="utf-8"?>
<Database>
  <!--
    Exploration-age Military victory block. See victory-culture-disable.xml in
    this folder for the full explanation: 1.4.0 lets the VICTORY_MILITARY_MODERN
    countdown victory (CountdownDuration=5, DOMINATION scoring) fire from ~50%
    through the Exploration age. Loads under
    `exploration-age-current-victory-military-disabled`
    (AgeInUse=AGE_EXPLORATION + MilitaryVictoryEnabled=0).

    NOTE: This blocks only the points-based military *countdown* victory. It does
    NOT touch VICTORY_DOMINATION (last-team-standing) — eliminating all other
    civilizations still ends the game normally.
  -->
  <Victories>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
  </Victories>

  <VictoryTypes>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set PrereqRequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set CountdownDuration='99999'/>
    </Update>
  </VictoryTypes>
</Database>
