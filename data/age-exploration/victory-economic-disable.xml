<?xml version="1.0" encoding="utf-8"?>
<Database>
  <!--
    Exploration-age Economic victory block. See victory-culture-disable.xml in
    this folder for the full explanation: 1.4.0 lets the VICTORY_ECONOMIC_MODERN
    countdown victory (CountdownDuration=5) fire from ~50% through the Exploration
    age. Loads under `exploration-age-current-victory-economic-disabled`
    (AgeInUse=AGE_EXPLORATION + EconomicVictoryEnabled=0).
  -->
  <Victories>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
  </Victories>

  <VictoryTypes>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set PrereqRequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set CountdownDuration='99999'/>
    </Update>
  </VictoryTypes>
</Database>
