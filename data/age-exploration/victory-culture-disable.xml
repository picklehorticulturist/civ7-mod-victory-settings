<?xml version="1.0" encoding="utf-8"?>
<Database>
  <!--
    Exploration-age Culture victory block.

    Civ7 1.4.0 made the countdown victories achievable starting ~50% through the
    EXPLORATION age, not just the Modern age. There is no separate exploration
    victory row: the gameplay DB (rebuilt per age) carries the same
    VICTORY_CULTURE_MODERN row while AgeInUse=AGE_EXPLORATION, with
    CountdownDuration=5 — so a runaway player triggers the 5-turn "victory
    imminent" countdown and wins before reaching the Modern age.

    This file loads under the modinfo criteria
    `exploration-age-current-victory-culture-disabled`
    (AgeInUse=AGE_EXPLORATION + CultureVictoryEnabled=0) and blocks that victory
    exactly like data/age-modern/victory-culture-disable.xml does for Modern.
    Reuses REQSET_VICTORY_NEVER_MET (created once by the always-active
    modern-age-victory-requirements-block ActionGroup, which loads in every age).
  -->
  <Victories>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
  </Victories>

  <!-- Block the 1.4.0 countdown-based victory layer -->
  <VictoryTypes>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set PrereqRequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set CountdownDuration='99999'/>
    </Update>
  </VictoryTypes>
</Database>
