<?xml version="1.0" encoding="utf-8"?>
<Database>
  <Victories>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_DOMINATION"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_DOMINATION"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
  </Victories>

  <!-- Block the new 1.4.0 countdown-based victory system -->
  <VictoryTypes>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set PrereqRequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set CountdownDuration='99999'/>
    </Update>
  </VictoryTypes>

  <Strategies>
    <Update>
      <Where LegacyPathType="LEGACY_PATH_MODERN_MILITARY"/>
      <Set MinNumConditionsNeeded='100'/>
    </Update>

    <Update>
      <Where LegacyPathType="LEGACY_PATH_MODERN_MILITARY"/>
      <Set MaxNumConditionsNeeded='100'/>
    </Update>

    <Update>
      <Where LegacyPathType='LEGACY_PATH_MODERN_MILITARY'/>
      <Set MinConditionPercentage='100'/>
    </Update>
  </Strategies>

  <Projects>
    <Update>
      <Where ProjectType='PROJECT_OPERATION_IVY'/>
      <Set MaxPlayerInstances='0'/>
    </Update>
  </Projects>
</Database>