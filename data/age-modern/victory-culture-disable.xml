<?xml version="1.0" encoding="utf-8"?>
<Database>
  <Victories>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
  </Victories>

  <!-- Block the new 1.4.0 countdown-based victory system -->
  <VictoryTypes>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set PrereqRequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_CULTURE_MODERN"/>
      <Set CountdownDuration='99999'/>
    </Update>
  </VictoryTypes>

  <Strategies>
    <Update>
      <Where LegacyPathType="LEGACY_PATH_MODERN_CULTURE"/>
      <Set MinNumConditionsNeeded='100'/>
    </Update>

    <Update>
      <Where LegacyPathType="LEGACY_PATH_MODERN_CULTURE"/>
      <Set MaxNumConditionsNeeded='100'/>
    </Update>

    <Update>
      <Where LegacyPathType='LEGACY_PATH_MODERN_CULTURE'/>
      <Set MinConditionPercentage='100'/>
    </Update>
  </Strategies>

  <Wonders>
    <Update>
      <Where ConstructibleType='WONDER_WORLDS_FAIR'/>
      <Set MaxWorldInstances='0'/>
    </Update>
    <Update>
      <Where ConstructibleType='WONDER_WORLDS_FAIR'/>
      <Set MaxPerPlayer='0'/>
    </Update>
  </Wonders>
</Database>