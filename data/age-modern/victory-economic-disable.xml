<?xml version="1.0" encoding="utf-8"?>
<Database>
  <Victories>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
  </Victories>

  <!-- Block the new 1.4.0 countdown-based victory system -->
  <VictoryTypes>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set PrereqRequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_ECONOMIC_MODERN"/>
      <Set CountdownDuration='99999'/>
    </Update>
  </VictoryTypes>

  <Strategies>
    <Update>
      <Where LegacyPathType="LEGACY_PATH_MODERN_ECONOMIC"/>
      <Set MinNumConditionsNeeded='100'/>
    </Update>

    <Update>
      <Where LegacyPathType="LEGACY_PATH_MODERN_ECONOMIC"/>
      <Set MaxNumConditionsNeeded='100'/>
    </Update>

    <Update>
      <Where LegacyPathType='LEGACY_PATH_MODERN_ECONOMIC'/>
      <Set MinConditionPercentage='100'/>
    </Update>
  </Strategies>

  <GreatPersonIndividuals>
    <Update>
      <Where GreatPersonIndividualType='GREAT_PERSON_INDIVIDUAL_VICTORY_JOHN_MAYNARD_KEYNES'/>
      <Set ActionCharges='0'/>
    </Update>
  </GreatPersonIndividuals>
</Database>