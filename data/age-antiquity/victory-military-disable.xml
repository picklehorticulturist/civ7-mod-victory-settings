<?xml version="1.0" encoding="utf-8"?>
<Database>
  <!--
    Antiquity-age Military victory block. Safety/future-proof mirror of the
    Exploration/Modern blocks; harmless no-op if the rows are absent from the
    Antiquity-age gameplay DB. Loads under
    `antiquity-age-current-victory-military-disabled`
    (AgeInUse=AGE_ANTIQUITY + MilitaryVictoryEnabled=0). Also blocks
    VICTORY_DOMINATION (legacy-layer military/domination victory).
  -->
  <Victories>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_DOMINATION"/>
      <Set EnabledByDefault='0'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_DOMINATION"/>
      <Set RequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
  </Victories>

  <VictoryTypes>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set PrereqRequirementSetId='REQSET_VICTORY_NEVER_MET'/>
    </Update>
    <Update>
      <Where VictoryType="VICTORY_MILITARY_MODERN"/>
      <Set CountdownDuration='99999'/>
    </Update>
  </VictoryTypes>
</Database>
